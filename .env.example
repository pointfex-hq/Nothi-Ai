# ==============================================================================
# Nothi AI Monorepo Unified Environment Template
# ==============================================================================

# ── Backend Configuration (backend/.env) ──────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=local-development-session-signing-secret-change-in-production-32chars
COOKIE_SAMESITE_NONE=false

# Seeded Role Credentials
ADMIN_EMAIL=admin
ADMIN_PASSWORD=AdminPassword123!
USER_EMAIL=user
USER_PASSWORD=UserPassword123!
NOTHI_ADMIN_USER_IDS=admin,admin_user

# Upstash Redis Configuration (Distributed sliding-window rate limit & token budget)
REDIS_URL="rediss://default:your-token@your-host.upstash.io:6379"

# Qdrant Cloud Vector Storage
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_LEGAL_COLLECTION=nothi-legal-official

# OpenRouter AI Model Routing
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Usage Limits Defaults
NOTHI_ASK_PER_MINUTE=5
NOTHI_ASK_PER_DAY=15
NOTHI_ASK_MAX_OUTPUT_TOKENS=600
NOTHI_ASK_DAILY_TOKEN_BUDGET=60000

# ── Frontend Configuration (frontend/.env.local) ──────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=

