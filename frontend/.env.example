# ==============================================================================
# Nothi AI Frontend Environment Variables (Local Dev & Production / Vercel)
# ==============================================================================

# Public URL of the frontend deployment (e.g., http://localhost:3000 or https://nothiai.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend destination URL for Next.js internal /api proxy rewrites.
# - Local dev: http://127.0.0.1:3001
# - Production with monolithic / same-server: http://backend:3001 or http://127.0.0.1:3001
# - Production with separate service (Render, Railway, Cloud Run): https://api.nothiai.com
INTERNAL_API_URL=http://127.0.0.1:3001

# Optional direct client-side API URL.
# If omitted or empty, all client API calls route through same-origin Next.js rewrites (/api -> $INTERNAL_API_URL).
# Only set if the browser must make direct cross-origin requests directly to the backend.
NEXT_PUBLIC_API_URL=
