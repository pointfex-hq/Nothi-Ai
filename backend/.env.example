# ==============================================================================
# Nothi AI Backend Environment Variables (Local Dev & Production Deploy)
# ==============================================================================

# Runtime environment (development | production)
NODE_ENV=development

# Server network settings
# - Local dev: 127.0.0.1
# - Cloud container / Docker / Railway / Render / VPS: 0.0.0.0 (or leave empty to auto-detect)
HOST=127.0.0.1
PORT=3001

# Allowed frontend origins for CORS and CSRF protection (comma-separated)
# In production, set to your canonical frontend URL(s), e.g.: https://nothiai.com,https://www.nothiai.com
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Session cookie secret (random 32+ character string in production)
SESSION_SECRET=local-development-session-signing-secret-change-in-production-32chars

# Optional cross-site cookie mode (set true only if frontend & backend are on different domains over HTTPS)
COOKIE_SAMESITE_NONE=false

# Admin account credentials (automatically initialized into local store on startup)
# Set these only for first-time Super Admin provisioning, then remove them.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Normal user account credentials (automatically initialized into local store on startup)
USER_EMAIL=user
USER_PASSWORD=UserPassword123!


# Upstash Redis Configuration (Distributed sliding-window rate limit & token budget)
# - rediss:// protocol supported (e.g. Upstash Redis)
REDIS_URL=

# OpenRouter API Key for statutory LLM reasoning (optional; falls back to deterministic engine if empty)
OPENROUTER_API_KEY=

# Qdrant Cloud settings for vector-based statutory retrieval (optional; falls back to local corpus)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LEGAL_COLLECTION=nothi-legal

# Rate limiting and quota defaults (resets at midnight UTC)
NOTHI_ASK_PER_MINUTE=5
NOTHI_ASK_PER_DAY=10
NOTHI_ASK_MAX_OUTPUT_TOKENS=500
NOTHI_ASK_DAILY_TOKEN_BUDGET=50000


# Google OAuth Web application credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
